# ============================================================
#  ShopeePay Partner API Gateway - konfigurasi contoh
# ============================================================
#  Copy file ini jadi `.env`, lalu isi dengan nilai milik Anda.
#
#      cp .env.example .env
#
#  Aturan:
#   - Baris diawali `#` dianggap komentar.
#   - Nilai diapit " atau ' akan otomatis dilepas.
#   - Environment variable yang SUDAH diset di shell/systemd
#     selalu menang atas isi file ini.
#   - JANGAN commit `.env` ke git (sudah masuk .gitignore).
# ============================================================


# --- WAJIB ---------------------------------------------------

# Token internal dari ShopeePay Partner Portal.
# Cara ambil: login ke portal mitra ShopeePay -> buka DevTools
# (F12) -> tab Network -> klik request apa saja -> salin nilai
# header "Authorization".
# Token ini berumur pendek dan expire rutin; bisa diganti saat
# runtime lewat POST /update-token tanpa restart.
SHOPEE_TOKEN=""


# Kunci untuk semua endpoint kecuali /. Ganti dengan string acak
# yang panjang, misal hasil `openssl rand -hex 32`.
API_KEY="ganti-dengan-api-key-acak-anda"


# --- OPSIONAL -----------------------------------------------

# Port HTTP server. Default: 4000
PORT=4000


# Notifikasi Telegram saat token expire.
# Token bot dari @BotFather, chat ID dari @userinfobot.
# Kosongkan keduanya kalau tidak ingin notifikasi.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""


# Static QRIS merchant, dipakai oleh endpoint /create-qris.
# Ambil dari app ShopeePay Mitra, lalu salin payload QR-nya
# apa adanya. WAJIB diapit tanda kutip.
# Kosongkan kalau tidak memakai /create-qris.
QRIS_STATIC=""
